node_modules/
*.log
dist/
coverage/
.DS_Store

# Generated acceptance, package, screenshot, and private/local analysis outputs.
# Formal version records live under docs/versions/; artifacts are regenerated or handed off locally.
artifacts/

# Server-side secrets must never be committed.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.secret
*.secrets
secrets/

# Machine-local agent state. Per-machine, regenerated, not part of the project,
# and easy to sweep into a commit by accident with `git add -A`.
.claude/
.codex/

# Real course captures stay outside the repository.
syllab-spike-*.json
fixtures/private/
evidence/private/

# The QA build shares the product source; it is a second output, not a second product.
dist-qa/

# Build provenance read by scripts/verify-build-separation.mjs.
.build-meta/

# Machine-local real acceptance state: the QA Chrome profile and its local config.
.tmp/
.real-test.local.json
artifacts/real-test/
