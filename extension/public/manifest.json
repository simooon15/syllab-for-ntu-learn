{
  "manifest_version": 3,
  "name": "Syllab for NTU Learn",
  "version": "0.1.0",
  "description": "Turn confirmed NTU Learn course information into a local Course Brief.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting", "webRequest", "offscreen"],
  "host_permissions": ["https://ntulearn.ntu.edu.sg/*"],
  "optional_host_permissions": [
    "https://*.blackboard.com/*",
    "https://*.prod.files.blackboard.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Syllab for NTU Learn"
  },
  "content_scripts": [
    {
      "matches": ["https://ntulearn.ntu.edu.sg/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://ntulearn.ntu.edu.sg/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
