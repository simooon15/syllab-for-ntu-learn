{
  "manifest_version": 3,
  "name": "Syllab for NTU Learn",
  "version": "0.2.0",
  "description": "Maintain a local, assessment-centred course state for your NTU Learn semester.",
  "icons": {
    "16": "icons/syllab-logo-16px.png",
    "32": "icons/syllab-logo-32px.png",
    "48": "icons/syllab-logo-48px.png",
    "128": "icons/syllab-logo-128px.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "offscreen",
    "sidePanel",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": ["https://ntulearn.ntu.edu.sg/*", "https://api.deepseek.com/*"],
  "optional_host_permissions": [
    "https://*.blackboard.com/*",
    "https://*.prod.files.blackboard.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Syllab for NTU Learn",
    "default_icon": {
      "16": "icons/syllab-logo-16px.png",
      "32": "icons/syllab-logo-32px.png",
      "48": "icons/syllab-logo-48px.png",
      "128": "icons/syllab-logo-128px.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ntulearn.ntu.edu.sg/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://ntulearn.ntu.edu.sg/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
